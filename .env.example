# Hugging Face token is required to download the gated IndicF5 model after accepting its terms.
HF_TOKEN=hf_your_token_here

# Optional tuning
MAX_VIDEO_MINUTES=25
MAX_UPLOAD_MB=2048
MAX_REFERENCE_MB=100
ASR_MODEL=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TTS_MODEL=ai4bharat/IndicF5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# DUB_DATA_DIR=./data
